  # feat/sector-backfill (2026-08-12): instruments.sector (yfinance) als
  # Fallback-Quelle fuer das Asset-Class-Gate. ASSET_CLASS_MAP deckt ~65
  # US-Ticker ab — gemessen fielen 43 von 54 gehaltenen Symbolen = 74.2% des
  # Equity fail-open durch das Gate.
  # SCHARF seit 2026-08-12, nach Backfill und Messung. Verteilung des Buchs
  # zum Zeitpunkt der Aktivierung (alle 59 Positionen haben einen Sektor):
  #   Industrials 17.1% | Financial Services 16.3% | Consumer Cyclical 9.7%
  #   Consumer Defensive 9.7% | Energy 6.8% | Basic Materials 6.8%
  #   Healthcare 6.8% | Utilities 3.6% | Technology 3.1% | Comm. Services 1.0%
  # Kein Sektor ueber dem 20%-Cap -> das Scharfschalten erzwingt HEUTE keinen
  # einzigen Verkauf, verhindert aber weiteres Anwachsen der groessten Klumpen.
  # Anteil des Buchs ohne jede Sektor-Grenze: 74.2% -> 0%.
  enforce_db_sectors: true

region_limits:                # feat/region-damper (2026-08-12)
  # Die reale Klumpenlage des Buchs ist GEOGRAFISCH, nicht sektoral. Stand der
  # Einfuehrung (Anteil am Equity): EU 34.8% | ASIA_CN 18.0% | US 9.7% |
  # GLOBAL 9.3% | ASIA_JP 5.2% | ASIA_AU 0.9%. Gemessen an den Positionen
  # allein sind es 44.7% EU. Kein Gate hat das je betrachtet.
  #
  # BEWUSST Damper statt Block: EU ist der Markt, in dem der Bot die meisten
  # Signale findet (US-Werte sind liquider und liefern seltener Extremwerte).
  # Ein harter Cap unterhalb der aktuellen Quote wuerde die Haupt-Signalquelle
  # abschalten — weniger Autonomie, nicht mehr. Ueber dem Soft-Cap schrumpft
  # die Positionsgroesse linear; der Bot baut den Klumpen handelnd ab.
  soft_cap_pct: 35.0          # ab hier schrumpft die Groesse
  hard_cap_pct: 50.0          # darueber kein weiterer Aufbau in der Region
  min_factor: 0.35            # kleinste Groesse am Hard-Cap

